#!/usr/bin/env bash
# gh-newrepo — create a GitHub repo pre-configured to my standard:
#   * squash-only merges (merge-commit and rebase disabled)
#   * auto-delete head branch on merge
#   * branch protection on the default branch:
#       PR required (0 approvals), linear history, no force-push, no deletion
#
# Defaults to --private. Picks a mode automatically:
#   * Inside an existing git repo -> publishes THAT repo in place (adds origin
#     and pushes the current branch). The repo name defaults to the folder name.
#   * Anywhere else -> scaffolds a fresh empty repo, clones it into ./<name>,
#     and seeds an empty commit on main.
#
# Usage:
#   gh-newrepo [name] [gh repo create flags...]
#
# Examples:
#   cd ~/irad/myproj && gh-newrepo                 # publish current repo as "myproj"
#   gh-newrepo my-tool --public --description "A thing"
#
# Requires: gh (authenticated). Honors init.defaultBranch=main.

set -euo pipefail

die() { printf 'gh-newrepo: %s\n' "$*" >&2; exit 1; }

command -v gh >/dev/null 2>&1 || die "gh CLI not found on PATH"
gh auth status >/dev/null 2>&1 || die "gh not authenticated — run: gh auth login"

# Repo name: first non-flag argument, else the current directory name.
if [ $# -ge 1 ] && [ "${1#-}" = "$1" ]; then
    name="$1"; shift
else
    name="$(basename "$PWD")"
fi
[ -n "$name" ] || die "could not determine repo name"

# Default to --private unless the caller specified a visibility flag.
vis=(--private)
for arg in "$@"; do
    case "$arg" in
        --private|--public|--internal) vis=() ;;
    esac
done

owner="$(gh api user -q .login)"

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    # --- Publish-in-place: this directory is already a git repo --------------
    git rev-parse HEAD >/dev/null 2>&1 \
        || die "current repo has no commits yet — commit something first"
    echo "Publishing existing repo as $owner/$name ..."
    gh repo create "$name" "${vis[@]}" "$@" --source=. --remote=origin --push
else
    # --- Scaffold a fresh empty repo and clone it into ./<name> --------------
    echo "Creating $owner/$name ..."
    gh repo create "$name" "${vis[@]}" "$@" --clone

    # A fresh empty repo has no commits/branch — seed one so protection sticks.
    if [ -d "$name/.git" ]; then
        echo "Seeding initial commit on main ..."
        ( cd "$name"
          git commit --allow-empty -m "Initial commit" >/dev/null
          git branch -M main
          git push -u origin main >/dev/null )
    fi
fi

# Determine the default branch GitHub ended up with (master vs main, etc.).
default_branch="$(gh repo view "$owner/$name" --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null || true)"
[ -n "$default_branch" ] || die "could not determine default branch for $owner/$name"

echo "Applying merge settings (squash-only, delete branch on merge) ..."
gh repo edit "$owner/$name" \
    --enable-squash-merge \
    --enable-merge-commit=false \
    --enable-rebase-merge=false \
    --delete-branch-on-merge

echo "Applying branch protection on $default_branch ..."
gh api -X PUT "repos/$owner/$name/branches/$default_branch/protection" --input - <<JSON >/dev/null
{
  "required_status_checks": null,
  "enforce_admins": false,
  "required_pull_request_reviews": { "required_approving_review_count": 0 },
  "restrictions": null,
  "required_linear_history": true,
  "allow_force_pushes": false,
  "allow_deletions": false
}
JSON

echo "Done: $owner/$name (squash-only, PR-required, linear history)."
