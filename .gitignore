# macOS
.DS_Store
._*

# Editor / scratch
*.swp
*.swo
*~
.idea/
.vscode/

# Machine-local overrides — every shared dotfile sources its *-local twin
# (e.g. ~/.zshrc -> ~/.zshrc-local). Never commit those.
*-local
*.local

# Secrets & keys
*.key
*.pem
id_rsa*
id_ed25519*
id_ecdsa*
known_hosts
authorized_keys
.env
.env.*
!.env.example

# Backups created by INSTALL.sh
*-[0-9]*-[0-9]*

# Project-scope Claude state (created by Claude Code in cwd).
# The TRACKED claude/ dir lives without the leading dot.
/.claude/

# Claude runtime state — only configs (rules/, agents/, commands/, skills/,
# CLAUDE.md, statusline.sh) should be tracked under claude/.
claude/sessions/
claude/projects/
claude/cache/
claude/telemetry/
claude/backups/
claude/file-history/
claude/shell-snapshots/
claude/paste-cache/
claude/debug/
claude/plans/
claude/agent-memory/
claude/session-env/
claude/downloads/
claude/history.jsonl
claude/*.jsonl
claude/*-cache.json
claude/.last-*
claude/mcp-needs-auth-cache.json

# Legacy. silent-change-audit used to write dated baselines here, one dir per audited
# repo; it now writes to docs/audits/ inside the repo it audited, so nothing new lands
# here. The old directory still exists at $HOME on machines that ran the skill before
# 2026-08-01, and those files carry file:line anchors into private repos while this repo
# is public. Kept as a guard so a future sync cannot sweep them in.
claude/skills/silent-change-audit/baselines/

# weekly-digest's scheduled-routine identifiers (names a private repo, holds a trigger
# id). SKILL.md points at this file; the file itself stays local.
claude/skills/weekly-digest/routines.local.md
